export default function usePosts() {
  const [posts, setPosts] = useState(() => {
    const saved = localStorage.getItem("blog-posts");
    return saved ? JSON.parse(saved) : initialPosts;
  });

  useEffect(() => {
    localStorage.setItem("blog-posts", JSON.stringify(posts));
  }, [posts]);

  const addPost = (post) => {
    setPosts((current) => [
      {
        ...post,
        id: Date.now(),
        views: 0,
        date: new Date().toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        }),
      },
      ...current,
    ]);
  };

  const updatePost = (id, updatedPost) => {
    setPosts((current) =>
      current.map((post) =>
        post.id === id
          ? { ...post, ...updatedPost }
          : post
      )
    );
  };

  const deletePost = (id) => {
    setPosts((current) =>
      current.filter((post) => post.id !== id)
    );
  };

  return {
    posts,
    addPost,
    updatePost,
    deletePost,
  };
}